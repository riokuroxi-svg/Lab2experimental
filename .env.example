# ─────────────────────────────────────────────────
# Ginko-MD · Variables de entorno
# Copia este archivo como ".env" y edita tus datos.
# El archivo .env NO se sube a GitHub (está en .gitignore).
# ─────────────────────────────────────────────────

# Puerto para el servidor HTTP de health check (BoxMine/hosting).
PORT=3000

# Método de vinculación por código de 8 dígitos (en vez de QR).
# Deja vacío para usar QR o elegir en consola.
PAIRING_METHOD=code
PAIRING_NUMBER=

# Google Gemini (para .ai / IA).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Entorno
NODE_ENV=production

# ── yt-dlp (descargas locales .ytdlp) ─────────────────
# Ruta del binario solo si NO está en el PATH del usuario del bot.
YTDLP_PATH=
# Canal de auto-update: nightly (default, fixes diarios) | stable
YTDLP_CHANNEL=nightly
# Desactiva el auto-update con: off
YTDLP_AUTO_UPDATE=
# Auto-update del PROPIO plugin: pega la URL raw del archivo en tu repo.
# Ej: https://raw.githubusercontent.com/TU-USUARIO/TU-REPO/main/cmds/downloads/ytdlp.js
YTDLP_PLUGIN_URL=

# ── Menú nativo ──────────────────────────────────────
# Por defecto se usa viewOnceMessage, como la ruta interactiva histórica.
# Pon 0 si el cliente de prueba no renderiza botones dentro de ese wrapper.
GINKO_NATIVE_MENU_VIEW_ONCE=1

# ── Comportamiento humano (anti-ban) ─────────────────
# off = desactiva el ritmo y los retrasos humanos (modo "robot").
GINKO_ANTIBAN=on
# Retraso aleatorio máximo (ms) antes de responder, con "escribiendo...".
# Rango 0-5000. Default 500 (~250ms de media: imperceptible, muestra
# el "escribiendo..." un instante). Sube a ~1500 si quieres más disimulo.
GINKO_HUMAN_DELAY_MS=500
# Espacio mínimo (ms) entre mensajes VISIBLES seguidos al mismo chat.
# Rango 0-3000. Default 350. Las reacciones/deletes no se espacian.
GINKO_HUMAN_PACE_MS=350

# ── Respaldo automático de sesiones ─────────────────
# off = desactivar. Cada día copia Sessions/ a backups/ con rotación.
GINKO_BACKUP_SESSIONS=on
# Cuántas copias diarias conservar (default 7).
GINKO_BACKUP_KEEP=7

# ── Agente IA "Ginko" (.ginko) [EXPERIMENTAL] ────────
# El agente usa OpenRouter (modelos :free). Key gratis en https://openrouter.ai/keys
# Sin esta key, .ginko funciona en "modo manual" (explica cómo activarlo).
OPENROUTER_API_KEY=
# Modelo de OpenRouter. Usa ":free" para no pagar por token.
GINKO_AI_MODEL=openai/gpt-oss-120b
# Ventana de memoria por chat (mensajes que recuerda).
GINKO_MEMORY_WINDOW=10
# Máximo de pasos del bucle agéntico (llamadas a herramientas) por mensaje.
GINKO_MAX_ITERATIONS=8

# ── Proveedor de IA del agente (elige uno) ────────────
# openrouter (default) | gemini | openai (cualquier Chat Completions: Groq, etc.)
GINKO_AI_PROVIDER=openrouter
# Si usas openrouter:
OPENROUTER_API_KEY=
GINKO_AI_MODEL=openai/gpt-oss-120b
# Si usas gemini (tu key de Google Studio ya la tienes):
GEMINI_API_KEY=
# Si usas openai/groq:
# GINKO_AI_BASE_URL=https://api.groq.com/openai/v1
# GINKO_AI_KEY=tu-key
# Si usas LiteRouter (proxy OpenAI-compatible, modelos :free):
#   GINKO_AI_PROVIDER=openrouter
#   OPENROUTER_API_KEY=tu-key-de-literouter
#   GINKO_AI_BASE_URL=https://api.literouter.com/v1
#   GINKO_AI_MODEL=gpt-oss-20b:free   <- el que mejor hace function calling
#   (gpt-oss-20b:free llama a las tools; gpt-oss-120b:free y claude-haiku-4.5-cheap:free no lo hacen bien)

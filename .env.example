# ─────────────────────────────────────────────────
# Ginko-MD · Variables de entorno
# Copia este archivo como ".env" y edita tus datos.
# El archivo .env NO se sube a GitHub (está en .gitignore).
# ─────────────────────────────────────────────────

# Puerto para el servidor HTTP de health check (BoxMine/hosting).
PORT=3000

# Método de vinculación por código de 8 dígitos (en vez de QR).
# Deja vacío para usar QR o elegir en consola.
PAIRING_METHOD=code
PAIRING_NUMBER=

# Google Gemini (para .ai / IA).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Entorno
NODE_ENV=production

# ── yt-dlp (descargas locales .ytdlp) ─────────────────
# Ruta del binario solo si NO está en el PATH del usuario del bot.
YTDLP_PATH=
# Canal de auto-update: nightly (default, fixes diarios) | stable
YTDLP_CHANNEL=nightly
# Desactiva el auto-update con: off
YTDLP_AUTO_UPDATE=
# Auto-update del PROPIO plugin: pega la URL raw del archivo en tu repo.
# Ej: https://raw.githubusercontent.com/TU-USUARIO/TU-REPO/main/cmds/downloads/ytdlp.js
YTDLP_PLUGIN_URL=

# ── Comportamiento humano (anti-ban) ─────────────────
# off = desactiva el ritmo y los retrasos humanos (modo "robot").
GINKO_ANTIBAN=on
# Retraso aleatorio máximo (ms) antes de responder, con "escribiendo...".
# Rango 0-5000. Default 500 (~250ms de media: imperceptible, muestra
# el "escribiendo..." un instante). Sube a ~1500 si quieres más disimulo.
GINKO_HUMAN_DELAY_MS=500
# Espacio mínimo (ms) entre mensajes VISIBLES seguidos al mismo chat.
# Rango 0-3000. Default 350. Las reacciones/deletes no se espacian.
GINKO_HUMAN_PACE_MS=350

# ── Respaldo automático de sesiones ─────────────────
# off = desactivar. Cada día copia Sessions/ a backups/ con rotación.
GINKO_BACKUP_SESSIONS=on
# Cuántas copias diarias conservar (default 7).
GINKO_BACKUP_KEEP=7

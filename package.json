    "aptoide-scraper": "github:DIEGO-OFC/dv-aptoide-scraper",
    "axios": "^1.20.0",
    "baileys": "github:this-xys/WaSocket",
    "cfonts": "^3.3.0",
    "chalk": "^4.1.2",
    "cheerio": "npm:cheerio@1.0.0-rc.12",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "file-type": "^21.3.4",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.0",
    "gradient-string": "^2.0.2",
    "grapheme-splitter": "^1.0.4",
    "human-readable": "^0.2.1",
    "jimp": "latest",
    "link-preview-js": "^3.2.0",
    "lodash": "latest",
    "moment": "^2.29.4",
    "moment-timezone": "^0.5.37",
    "node-cache": "latest",
    "node-fetch": "^3.2.10",
    "node-webpmux": "^3.2.0",
    "pino": "^8.8.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "readline-sync": "^1.4.10",

{
  "name": "ginko-md",
  "version": "1.0.0",
  "description": "Ginko-MD — Bot WhatsApp Multi-Device, estable y fácil de usar",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "start": "node index.js",
    "test:native-menu": "node --test test/native-menu.test.mjs",
    "test:lab2-fixes": "node --test test/lab2-mining-code.test.mjs test/lab2-benchdl.test.mjs"
  },
  "imports": {
    "#serialize": "./core/serialize.js",
    "#main": "./main.js",
    "#core/*": "./core/*.js",
    "#system/*": "./core/system/*.js",
    "#lib/*": "./core/lib/*.js",
    "#events": "./cmds/events.js",
    "#db": "./core/system/database.js"
  },
  "keywords": [
    "whatsapp-bot",
    "baileys-md",
    "multi-device",
    "ginko-md"
  ],
  "author": "Tu",
  "license": "MIT",
